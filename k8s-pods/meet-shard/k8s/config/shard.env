# Non-secret settings of every shard's web, Prosody and Jicofo containers (envFrom a generated
# ConfigMap). Derived from deploy/env.talkchief: scripts/test-k8s-pods.py requires every key there to
# have the same value here, except the keys listed under "Changed for Kubernetes", and requires
# every key there to be present. Secrets (XMPP passwords, TURN secret, events secret) come from
# Secrets, never from this file.

TZ=UTC
PUBLIC_URL=https://meet.talkchief.io
ENABLE_HSTS=1
ENABLE_LETSENCRYPT=0

# Product surface
ENABLE_WELCOME_PAGE=0
ENABLE_CLOSE_PAGE=1
ENABLE_PREJOIN_PAGE=1
ENABLE_REQUIRE_DISPLAY_NAME=1
ENABLE_THIRD_PARTY_REQUESTS=0
ENABLE_CALENDAR=0
ENABLE_LOBBY=1
ENABLE_BREAKOUT_ROOMS=1
ENABLE_AV_MODERATION=1
ENABLE_END_CONFERENCE=1
ENABLE_XMPP_WEBSOCKET=1
DEFAULT_LANGUAGE=en

# Auth (unchanged): RS256 member tokens, anonymous guests confined to "g-" rooms, tenant-scoped
# rooms, moderator only from the token. See deploy/env.talkchief for the reasons.
ENABLE_AUTH=1
AUTH_TYPE=jwt
ENABLE_GUESTS=1
JWT_ALLOW_EMPTY=0
JWT_APP_ID=talkchief-cowork
JWT_SIGN_TYPE=RS256
JWT_ACCEPTED_ISSUERS=talkchief-cowork
JWT_ACCEPTED_AUDIENCES=talkchief-meet
ENABLE_SUBDOMAINS=true
JWT_ENABLE_DOMAIN_VERIFICATION=true
ENABLE_AUTO_OWNER=0
JICOFO_ENABLE_AUTH=0
XMPP_MUC_MODULES=muc_wait_for_host,token_affiliation,talkchief_room_policy,talkchief_room_events,talkchief_room_gate,talkchief_host_drop
WAIT_FOR_HOST_DISABLE_AUTO_OWNERS=1
XMPP_MUC_CONFIGURATION=token_verification_allowlist={'guest.meet.jitsi'},token_verification_require_token_for_moderation=true,talkchief_room_check_timeout=2,talkchief_host_drop_grace=60

TURN_PORT=3478
TURN_TRANSPORT=udp,tcp

PROSODY_ENABLE_RATE_LIMITS=1
PROSODY_ENABLE_METRICS=1
JICOFO_ENABLE_REST=1

# ---- Changed for Kubernetes ----
# HAProxy (k8s-pods/meet-haproxy) holds the certificate and redirects HTTP; web serves plain HTTP on
# 8000 inside the cluster.
ENABLE_HTTP_REDIRECT=0
DISABLE_HTTPS=1
# The key server is the meet-asap Service (was the compose name "asap").
JWT_ASAP_KEYSERVER=http://meet-asap.meet.svc.cluster.local:8080/asap
# TURN and STUN: the shared coturn fleet on the three workers (Cowork PR, namespace media), each
# worker its own name. Every client gets all three, so one down does not break a meeting:
# stun: 3478, turn: 3478 UDP and TCP, turns: 443 (TLS). Credentials are time-limited (12 h)
# HMAC credentials Prosody derives per client from the Meet secret (Secret turn-meet, env
# TURN_CREDENTIALS); no static TURN user or password exists anywhere.
# TURN_HOST/TURNS_HOST turn on Prosody's external_services module and produce the turn/turns
# entries; the image's template (prosody.cfg.lua, stable-11248-2) takes only one STUN host, so
# GLOBAL_CONFIG, rendered after it in the same global scope, sets the full list including one STUN
# entry per server. A literal backslash-n separates its lines (the image splits on it).
TURN_HOST=turn1.talkchief.io,turn2.talkchief.io,turn3.talkchief.io
TURNS_HOST=turn1.talkchief.io,turn2.talkchief.io,turn3.talkchief.io
TURNS_PORT=443
TURN_TTL=43200
GLOBAL_CONFIG=external_services = {\n  { type = "stun", host = "turn1.talkchief.io", port = 3478, transport = "udp" },\n  { type = "stun", host = "turn2.talkchief.io", port = 3478, transport = "udp" },\n  { type = "stun", host = "turn3.talkchief.io", port = 3478, transport = "udp" },\n  { type = "turn", host = "turn1.talkchief.io", port = 3478, transport = "udp", secret = true, ttl = 43200, algorithm = "turn" },\n  { type = "turn", host = "turn1.talkchief.io", port = 3478, transport = "tcp", secret = true, ttl = 43200, algorithm = "turn" },\n  { type = "turn", host = "turn2.talkchief.io", port = 3478, transport = "udp", secret = true, ttl = 43200, algorithm = "turn" },\n  { type = "turn", host = "turn2.talkchief.io", port = 3478, transport = "tcp", secret = true, ttl = 43200, algorithm = "turn" },\n  { type = "turn", host = "turn3.talkchief.io", port = 3478, transport = "udp", secret = true, ttl = 43200, algorithm = "turn" },\n  { type = "turn", host = "turn3.talkchief.io", port = 3478, transport = "tcp", secret = true, ttl = 43200, algorithm = "turn" },\n  { type = "turns", host = "turn1.talkchief.io", port = 443, transport = "tcp", secret = true, ttl = 43200, algorithm = "turn" },\n  { type = "turns", host = "turn2.talkchief.io", port = 443, transport = "tcp", secret = true, ttl = 43200, algorithm = "turn" },\n  { type = "turns", host = "turn3.talkchief.io", port = 443, transport = "tcp", secret = true, ttl = 43200, algorithm = "turn" }\n};
# Not used by the shard (each bridge advertises its own node's address): CONFIG, HTTP_PORT,
# HTTPS_PORT and JVB_ADVERTISE_IPS of deploy/env.talkchief are left out on purpose.

# ---- Added for Kubernetes ----
# Web, Prosody and Jicofo share the pod's network: everything is on localhost.
XMPP_SERVER=127.0.0.1
XMPP_BOSH_URL_BASE=http://127.0.0.1:5280
NGINX_RESOLVER=kube-dns.kube-system.svc.cluster.local
# Room events to the meet-events relay, which forwards them to Cowork's in-cluster Service.
TALKCHIEF_EVENTS_URL=http://meet-events.meet.svc.cluster.local:8080/talkchief/meetings/events
# Prometheus (the cluster's agent) scrapes Prosody's /metrics from the pod network.
PROSODY_METRICS_ALLOWED_CIDR=10.0.0.0/8
# Jicofo's Java heap must stay inside the container's 1 GiB memory limit.
JICOFO_MAX_MEMORY=640m
# Jicofo puts at most this many participants on one bridge (upstream default 80). Bridges are CPX22
# (2 shared vCPU, owner 2026-11-25). The cap is per Jicofo: with two shards a bridge carried 40 with
# the value at 25 on the test cluster (2026-11-25), and one CPX22 bridge carries about 30 at stress
# 0.5, so 15 per shard. The per-interval ramp-up limit is in custom-jicofo.conf.
MAX_BRIDGE_PARTICIPANTS=15
