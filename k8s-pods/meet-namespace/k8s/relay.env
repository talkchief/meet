# Bridge-to-bridge relay (Octo), shared by Jicofo (both shards) and every video bridge through the
# meet-relay ConfigMap. Switched OFF: a meeting lives on one bridge (design 5.8). The one toggle is
# ENABLE_OCTO, set per cluster in the overlay (k8s-pods/overlays/cowork); the test cluster turns it on
# for the large-meeting test. With it on, Jicofo's IntraRegionBridgeSelectionStrategy keeps a
# meeting on one bridge and adds another bridge of the same region (eu) only when the first is
# overloaded; each bridge's relay id is its pod name (JVB_OCTO_RELAY_ID in k8s-pods/meet-jvb).
ENABLE_OCTO=false
JVB_OCTO_REGION=eu
JICOFO_OCTO_REGION=eu
OCTO_BRIDGE_SELECTION_STRATEGY=IntraRegionBridgeSelectionStrategy
