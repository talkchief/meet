# TalkChief Cowork Meetings -- non-secret overrides, appended to the upstream
# env.example by scripts/install.sh. Secrets (XMPP component passwords) come from
# upstream gen-passwords.sh and are generated on the server only.

CONFIG=/opt/talkchief-meet/config
HTTP_PORT=80
HTTPS_PORT=443
TZ=UTC
PUBLIC_URL=https://meet.talkchief.io
JVB_ADVERTISE_IPS=46.225.31.248
ENABLE_HTTP_REDIRECT=1
ENABLE_HSTS=1
# Cloudflare-proxied: TLS comes from a Cloudflare Origin Certificate placed in
# ${CONFIG}/web/keys/cert.{crt,key}. Set to 1 only if the record is DNS-only.
ENABLE_LETSENCRYPT=0

# Product surface
ENABLE_WELCOME_PAGE=0
ENABLE_CLOSE_PAGE=0
ENABLE_PREJOIN_PAGE=1
ENABLE_REQUIRE_DISPLAY_NAME=1
ENABLE_THIRD_PARTY_REQUESTS=0
ENABLE_CALENDAR=0
ENABLE_LOBBY=1
ENABLE_BREAKOUT_ROOMS=1
ENABLE_AV_MODERATION=1
ENABLE_END_CONFERENCE=1
ENABLE_XMPP_WEBSOCKET=1
DEFAULT_LANGUAGE=en

# Auth: JWT only, RS256 public keys served from /asap/, no anonymous domain.
# Rooms are tenant-scoped: https://meet.talkchief.io/<team>/<room-uuid>, JWT sub=<team>.
ENABLE_AUTH=1
AUTH_TYPE=jwt
ENABLE_GUESTS=0
JWT_ALLOW_EMPTY=0
JWT_APP_ID=talkchief-cowork
JWT_SIGN_TYPE=RS256
JWT_ASAP_KEYSERVER=http://asap/asap
JWT_ACCEPTED_ISSUERS=talkchief-cowork
JWT_ACCEPTED_AUDIENCES=talkchief-meet
ENABLE_SUBDOMAINS=true
# Moderator comes only from the token (context.user.affiliation); guests wait
# for a host and are admitted from the lobby.
ENABLE_AUTO_OWNER=0
XMPP_MUC_MODULES=muc_wait_for_host,token_affiliation
WAIT_FOR_HOST_DISABLE_AUTO_OWNERS=1

# TURN (coturn on this host, see docker-compose.override.yml)
TURN_HOST=turn.talkchief.io
TURN_PORT=3478
TURN_TRANSPORT=udp,tcp
TURNS_HOST=turn.talkchief.io
TURNS_PORT=5349

PROSODY_ENABLE_RATE_LIMITS=1
PROSODY_ENABLE_METRICS=1
