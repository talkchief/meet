# TalkChief Meet bridge node settings. Rendered on the main host by
# scripts/bridge-bundle.sh (it fills in every placeholder between at-signs,
# from /opt/talkchief-meet/.env and VERSION) and installed by join.sh as
# /opt/talkchief-meet-bridge/.env, mode 0600.
#
# Exactly one secret: JVB_AUTH_PASSWORD. Never add others here (the Jicofo
# password, TURN_CREDENTIALS, jwt/private.pem, TALKCHIEF_EVENTS_SECRET or
# certificates). Note that the jvb account is a Prosody admin upstream: treat a
# bridge node as trusted as the main host.

# Same image as the main host (Jicofo and the bridge speak colibri2).
JITSI_IMAGE_REPO=@JITSI_IMAGE_REPO@
JITSI_IMAGE_VERSION=@JITSI_IMAGE_VERSION@

# The main host's Prosody, over the private network only.
MAIN_PRIVATE_IP=@MAIN_PRIVATE_IP@
XMPP_SERVER=@MAIN_PRIVATE_IP@
XMPP_PORT=5222
XMPP_AUTH_DOMAIN=@XMPP_AUTH_DOMAIN@
XMPP_INTERNAL_MUC_DOMAIN=@XMPP_INTERNAL_MUC_DOMAIN@
JVB_BREWERY_MUC=@JVB_BREWERY_MUC@
JVB_AUTH_USER=@JVB_AUTH_USER@
JVB_AUTH_PASSWORD=@JVB_AUTH_PASSWORD@

# This node.
BRIDGE_NAME=@BRIDGE_NAME@
BRIDGE_PRIVATE_IP=@NODE_PRIVATE_IP@
JVB_ADVERTISE_IPS=@NODE_PUBLIC_IP@
JVB_MUC_NICKNAME=jvb-@BRIDGE_NAME@
JVB_INSTANCE_ID=@BRIDGE_NAME@
JVB_PORT=10000
# The static mapping above gives the public address; no third-party STUN.
JVB_DISABLE_STUN=1
# POST 127.0.0.1:8080/colibri/shutdown for a graceful drain (runbook).
SHUTDOWN_REST_ENABLED=true

# Octo / bridge relay: must match Jicofo on the main host.
ENABLE_OCTO=@ENABLE_OCTO@
JVB_OCTO_REGION=@JVB_OCTO_REGION@
JVB_OCTO_RELAY_ID=@BRIDGE_NAME@

TZ=UTC

# Sentry (the DSN is the project's public key, not a secret). An empty
# COMPOSE_PROFILES turns the node monitor off.
TALKCHIEF_SENTRY_DSN=@SENTRY_DSN@
COMPOSE_PROFILES=@COMPOSE_PROFILES@
